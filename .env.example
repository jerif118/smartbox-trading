# ── IA: Modelos de los agentes LLM (Trader y Risk) ──
# Formato: provider/model. Solo estos DOS agentes ejercen juicio con LLM; la
# consolidación (Desk_Manager) y la gestión de posiciones son deterministas.
# Providers: openai, anthropic, google, mistral, deepseek, groq, ollama, lm_studio, openai_compatible
# Ejemplos:
#   openai/gpt-4o-mini
#   anthropic/claude-sonnet-5             (recomendado: calidad casi-Opus a coste medio)
#   anthropic/claude-opus-4-8             (máxima capacidad; más caro)
#   google/gemini-1.5-pro
#   ollama/llama3.1                       (modelo local, requiere Ollama corriendo)
#   openai_compatible/mi-modelo           (cualquier endpoint OpenAI-compatible)
#
# Recomendación: como los niveles (entry/SL/TP) y la decisión final son
# deterministas, el modelo afecta sobre todo la CALIDAD de dirección/veto y del
# razonamiento, no los precios. Subir Trader/Risk a un modelo más capaz mejora el
# juicio; requiere configurar la API key del provider correspondiente abajo.
# El string exacto debe existir en tu versión de LiteLLM/CrewAI.
#
# ── IMPORTANTE ───────────────────────────────────────
# 1. Reemplaza sk-tu-clave-openai-aqui con tu API key real
# 2. Configura la API key del provider que uses (deja vacías las que no)
# ────────────────────────────────────────────────────
AGENT_TRADER_MODEL=openai/gpt-4o-mini
AGENT_RISK_ANALYST_MODEL=openai/gpt-4o-mini

# ── Endpoints de providers locales / custom ──
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ── API keys por provider (deja vacíos los que no uses) ──
# Requerida solo si usas openai/* o si OPENAI_COMPATIBLE_BASE_URL apunta a un servicio con auth
OPENAI_API_KEY=sk-tu-clave-openai-aqui
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# ── Símbolos y temporalidad ───────────────────────────
# Epics de Capital.com (el DAX es DE40, no GER40)
SYMBOLS=US500,US100
TIMEFRAME=MINUTE_5

# ── Caja (horas en la zona del mercado, MARKET_TZ) ────
BOX_DATE=
BOX_START=08:00
BOX_END=09:55

# ── Ventana de datos / Volume Profile ─────────────────
# Déjalos vacíos para usar una ventana móvil de VP_LOOKBACK_DAYS
# días hasta ahora (recomendado). Fíjalos solo para backtests.
START_VP=
END_VP=
VP_LOOKBACK_DAYS=3

# ── Capital.com  ───────────────────────────────────────
EMAIL=tu-email
PASSWORD=tu-password
API_KEY=tu-api-key

# ── SimpleFX ──────────────────────────────────────────
ID=tu-client-id
KEY=tu-client-secret
SIMPLE_ACCOUNT=tu-cuenta
SIMPLE_REALITY=DEMO
VOLUME=1.0
LOG_LEVEL=INFO

# ── Trading ───────────────────────────────────────────
MAX_ORDERS_PER_DAY=4
MIN_RR_RATIO=1.0
MIN_CONFIDENCE=55
MAX_DAILY_LOSS=500.0
STRATEGY_PROFILE=active
ACTIVE_MIN_CONFLUENCE=55
FULL_RISK_CONFLUENCE=70
SIGNAL_MAX_AGE_MINUTES=15
# required | size_reduction | independent
PRIMARY_CONFIRMATION_MODE=size_reduction
MACRO_BLACKOUT_MINUTES=15
MACRO_CAUTION_MINUTES=120
MAX_CORRELATED_SETUPS=1

# ── Seguridad ─────────────────────────────────────────
DRY_RUN=true

# ── Modo de ejecución ─────────────────────────────────
RUN_MODE=monitor
OPERATE_START=10:00
OPERATE_END=12:00
MONITOR_INTERVAL_S=300

# ── Persistencia ──────────────────────────────────────
DB_PATH=./data/smartbox.db
DATA_LOADER_PATH=./data/parquet
VP_LOADER_PATH=./data/parquet/vp
LOG_DIR=./logs

# ── IA: Modelos por agente (multi-provider simultáneo) ──
# Formato: provider/model
# Providers soportados: openai, anthropic, google, mistral, deepseek, groq, ollama, lm_studio, openai_compatible
# Ejemplos:
#   openai/gpt-4o-mini
#   anthropic/claude-3-5-sonnet-20241022
#   google/gemini-1.5-pro
#   mistral/mistral-large-latest
#   deepseek/deepseek-chat
#   groq/llama-3.1-70b-versatile
#   ollama/llama3.1                (modelo local, requiere Ollama corriendo)
#   lm_studio/qwen2.5-7b-instruct  (modelo local, requiere LM Studio)
#   openai_compatible/mi-modelo    (cualquier endpoint OpenAI-compatible)
#
# ── IMPORTANTE ───────────────────────────────────────
# 1. Reemplaza sk-tu-clave-openai-aqui con tu API key real
# 2. Obtén una en: https://platform.openai.com/api-keys
# 3. Configura las demás API keys que uses (deja vacías las que no)
# ────────────────────────────────────────────────────
AGENT_DECISION_MAKER_MODEL=openai/gpt-4o-mini
AGENT_TRADER_MODEL=openai/gpt-4o-mini
AGENT_RISK_ANALYST_MODEL=openai/gpt-4o-mini
AGENT_MTFA_MODEL=openai/gpt-4o-mini
AGENT_POSITION_MANAGER_MODEL=openai/gpt-4o-mini

# ── Endpoints de providers locales / custom ──
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234/v1
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ── API keys por provider (deja vacíos los que no uses) ──
# Requerida solo si usas openai/* o si OPENAI_COMPATIBLE_BASE_URL apunta a un servicio con auth
OPENAI_API_KEY=sk-tu-clave-openai-aqui
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# ── Símbolos y temporalidad ───────────────────────────
# Epics de Capital.com (el DAX es DE40, no GER40)
SYMBOLS=US500,US100
TIMEFRAME=MINUTE_5

# ── Caja (horas en la zona del mercado, MARKET_TZ) ────
BOX_DATE=
BOX_START=08:00
BOX_END=09:55

# ── Ventana de datos / Volume Profile ─────────────────
# Déjalos vacíos para usar una ventana móvil de VP_LOOKBACK_DAYS
# días hasta ahora (recomendado). Fíjalos solo para backtests.
START_VP=
END_VP=
VP_LOOKBACK_DAYS=3

# ── Capital.com  ───────────────────────────────────────
EMAIL=tu-email
PASSWORD=tu-password
API_KEY=tu-api-key

# ── SimpleFX ──────────────────────────────────────────
ID=tu-client-id
KEY=tu-client-secret
SIMPLE_ACCOUNT=tu-cuenta
SIMPLE_REALITY=DEMO
VOLUME=1.0
LOG_LEVEL=INFO

# ── Trading ───────────────────────────────────────────
MAX_ORDERS_PER_DAY=4
MIN_RR_RATIO=1.5
MIN_CONFIDENCE=0
MAX_DAILY_LOSS=500.0

# ── Seguridad ─────────────────────────────────────────
DRY_RUN=true

# ── Persistencia ──────────────────────────────────────
DB_PATH=./data/smartbox.db
DATA_LOADER_PATH=./data/parquet
VP_LOADER_PATH=./data/parquet/vp
LOG_DIR=./logs
